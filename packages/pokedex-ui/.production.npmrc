@sms:registry=https://pkgs.dev.azure.com/sms-digital/SMS-digital-Application-Platform/_packaging/sms-plasma/npm/registry/
@fortawesome:registry=https://pkgs.dev.azure.com/sms-digital/SMS-digital-Application-Platform/_packaging/sms-plasma/npm/registry/
always-auth=true

; Azure auth (NPM_TOKEN)
//pkgs.dev.azure.com/sms-digital/SMS-digital-Application-Platform/_packaging/sms-plasma/npm/registry/:username=sms-digital
//pkgs.dev.azure.com/sms-digital/SMS-digital-Application-Platform/_packaging/sms-plasma/npm/registry/:_password=${NPM_TOKEN}
//pkgs.dev.azure.com/sms-digital/SMS-digital-Application-Platform/_packaging/sms-plasma/npm/registry/:email=build@example.com

; Optional direct Font Awesome registry
//npm.fontawesome.com/:_authToken=${NPM_TOKEN_FONTAWESOME}